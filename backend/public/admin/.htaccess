# /admin — служебная зона. Второй заслон на уровне сервера (HTTP Basic) ПЕРЕД самой админкой.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

# ---------------------------------------------------------------------------
#  ВТОРОЙ ФАКТОР ДОСТУПА (включить на шаге деплоя, см. DEPLOY.md §4, шаг 5):
#  1) создать файл паролей ВНЕ веб-корня:
#        htpasswd -c /home/ВАШ_ЛОГИН/.htpasswd-admin имя_для_входа
#  2) прописать абсолютный путь ниже и снять комментарии с 4 строк:
# ---------------------------------------------------------------------------
# AuthType Basic
# AuthName "ICEBERG — служебная зона"
# AuthUserFile /home/ВАШ_ЛОГИН/.htpasswd-admin
# Require valid-user

# Примечание: сначала убедитесь, что путь AuthUserFile верный — иначе вход в админку
# отдаст 500. Пока строки закомментированы, работает встроенная защита (пароль + 2FA).
